{
  "name": "orion-note-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\" \"wrangler dev --local --port 8787\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run cloud:migrate:local && playwright test",
    "cloud:dev": "wrangler dev --local --port 8787",
    "cloud:migrate:local": "wrangler d1 migrations apply orion-note-learn --local",
    "cloud:migrate": "wrangler d1 migrations apply orion-note-learn --remote",
    "cloud:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dompurify": "^3.2.0",
    "express": "^5.1.0",
    "html2canvas-pro": "^1.5.0",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
