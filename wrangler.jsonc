{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orion-note-learn-sync",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orion-note-learn",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "orion-note-learn-images"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,https://orion-note-learn.vercel.app"
  },
  "observability": {
    "enabled": true
  }
}
