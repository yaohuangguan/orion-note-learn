# Server binds to loopback by default. Set HOST=0.0.0.0 for a trusted LAN.
HOST=127.0.0.1
PORT=3001
# Extra trusted HTTPS hosts for OpenAI-compatible services, comma-separated.
# Do not add private/internal hosts on a public deployment.
AI_ALLOWED_HOSTS=
# Cloudflare Worker 地址。Vercel 生产环境中设置为部署后的 workers.dev 或自定义域名。
VITE_SYNC_API_URL=http://localhost:8787
